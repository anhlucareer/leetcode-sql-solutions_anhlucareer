WITH category_segment AS (
    SELECT u1.user_id, p1.category AS category1, p2.category AS category2
    FROM ProductPurchases u1 
        JOIN ProductPurchases u2 ON u1.user_id=u2.user_id AND u1.product_id <> u2.product_id
        JOIN ProductInfo p1 ON p1.product_id=u1.product_id
        JOIN ProductInfo p2 ON p2.product_id=u2.product_id
    WHERE p1.category < p2.category
    GROUP BY u1.user_id, p1.category, p2.category
)
SELECT category1, category2, COUNT(user_id) AS customer_count
FROM category_segment
GROUP BY category1, category2
HAVING COUNT(user_id) >=3
ORDER BY customer_count DESC, category1 ASC, category2 ASC;
