WITH invalid_table AS (
    SELECT ip
    FROM logs CROSS APPLY string_split( ip, '.') spl
    GROUP BY ip
    HAVING  SUM(CASE 
                WHEN spl.value LIKE '0%' AND spl.value <> '0' THEN 1 
                ELSE 0 
            END) > 0 
        OR  SUM(CASE 
                WHEN CAST(spl.value AS INT) > 255 THEN 1 
                ELSE 0 
            END) > 0
        OR  COUNT(*) <> 4
)
SELECT ip, COUNT(log_id) AS invalid_count
FROM logs
WHERE ip IN (SELECT ip FROM invalid_table)
GROUP BY ip
ORDER BY invalid_count DESC, ip DESC;
