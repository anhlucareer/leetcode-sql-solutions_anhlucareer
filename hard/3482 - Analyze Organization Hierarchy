WITH t1 (employee_id, employee_name, level) AS (
    SELECT employee_id, employee_name, 1 AS level
    FROM Employees
    WHERE manager_id IS NULL
    UNION ALL
    SELECT e1.employee_id, e1.employee_name, t1.level + 1 
    FROM Employees e1, t1
    WHERE e1.manager_id = t1.employee_id
),
hierarchy (ancestor_id, descendant_id) AS (
    SELECT employee_id, employee_id 
    FROM Employees
    UNION ALL
    SELECT h.ancestor_id, e.employee_id
    FROM hierarchy h JOIN Employees e 
        ON h.descendant_id = e.manager_id
)
SELECT  h.ancestor_id AS employee_id, 
        t1.employee_name, 
        t1.level, 
        COUNT(h.descendant_id) - 1 AS team_size, 
        SUM(e.salary) AS budget
FROM hierarchy h 
    LEFT JOIN t1            ON h.ancestor_id = t1.employee_id
    LEFT JOIN Employees e   ON h.descendant_id = e.employee_id
GROUP BY h.ancestor_id, t1.employee_name, t1.level
ORDER BY t1.level ASC, budget DESC, t1.employee_name ASC;
