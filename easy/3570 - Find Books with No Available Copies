WITH table_A AS (
    SELECT DISTINCT l.book_id,l.title,l.author,l.genre,l.publication_year,l.total_copies, 
    COUNT(b.record_id) OVER (PARTITION BY b.book_id) AS current_borrowers
    FROM borrowing_records b 
        INNER JOIN library_books l 
            ON b.book_id=l.book_id 
            AND b.return_date IS NULL
)
SELECT book_id,title,author,genre,publication_year,current_borrowers
FROM table_A
WHERE total_copies - current_borrowers= 0
ORDER BY current_borrowers DESC, title ASC;
