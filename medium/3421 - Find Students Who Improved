WITH table_A AS (
    SELECT  student_id,
            subject,
            MIN(exam_date) AS min_date,
            MAX(exam_date) AS max_date
    FROM Scores
    GROUP BY student_id,subject
    HAVING COUNT(exam_date) >1 
)
SELECT  a.student_id,
        a.subject, 
        s1.score AS first_score, 
        s2.score AS latest_score
FROM table_A a
INNER JOIN Scores s1 
    ON a.student_id = s1.student_id AND a.subject = s1.subject AND a.min_date = s1.exam_date
INNER JOIN Scores s2 
    ON a.student_id = s2.student_id AND a.subject = s2.subject AND a.max_date = s2.exam_date
WHERE s2.score > s1.score
ORDER BY a.student_id, a.subject ASC;
