WITH table_A AS (
    SELECT d.name AS Department, 
    e.name AS Employee, 
    e.salary AS Salary, 
    DENSE_RANK() OVER (PARTITION BY e.departmentId ORDER BY e.salary DESC) AS rn
    FROM Employee e INNER JOIN Department d 
        ON e.departmentId=d.id
)
SELECT Department, Employee, Salary
FROM table_A
WHERE rn=1
