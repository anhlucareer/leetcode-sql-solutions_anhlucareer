WITH week_num AS (
    SELECT *,
    DATEADD(week 
            , DATEDIFF(week, 0, DATEADD(day, -1, meeting_date))
            , 0) AS week_monday
    FROM meetings
),
meeting_heavy AS (
    SELECT employee_id,
    SUM(duration_hours) AS meeting_hours
    FROM week_num
    GROUP BY employee_id, week_monday
    HAVING SUM(duration_hours) > 20
)
SELECT  m.employee_id, 
        employee_name, 
        department, 
        COUNT(m.meeting_hours) AS meeting_heavy_weeks
FROM meeting_heavy m INNER JOIN employees e 
    ON m.employee_id = e.employee_id
GROUP BY m.employee_id, employee_name, department
HAVING COUNT(m.meeting_hours) >= 2
ORDER BY meeting_heavy_weeks DESC, employee_name ASC;
