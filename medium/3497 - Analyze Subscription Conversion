WITH selected_user_id AS (
    (SELECT user_id FROM UserActivity WHERE activity_type = 'free_trial')
    INTERSECT
    (SELECT user_id FROM UserActivity WHERE activity_type = 'paid')
)
SELECT user_id,
ROUND(AVG(  CASE 
            WHEN activity_type = 'free_trial' 
            THEN CAST(activity_duration AS FLOAT) 
            END)
,2) AS trial_avg_duration,
ROUND(AVG(  CASE 
            WHEN activity_type = 'paid' 
            THEN CAST(activity_duration AS FLOAT) 
            END),
2) AS paid_avg_duration
FROM UserActivity
WHERE user_id IN (SELECT user_id FROM selected_user_id)
GROUP BY user_id
ORDER BY user_id ASC;
