SELECT
    CASE 
        WHEN id % 2 = 1 AND id = (SELECT MAX(id) FROM Seat) THEN id      -- last & unpaired → stays
        WHEN id % 2 = 1 THEN id + 1                                       -- odd → move up
        ELSE id - 1                                                       -- even → move down
    END AS id,
    student
FROM Seat
ORDER BY id;
