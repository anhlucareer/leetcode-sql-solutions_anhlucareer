WITH customer_behavior AS (
    SELECT customer_id,
    CAST(COUNT(order_id) AS FLOAT) AS total_orders,
    CAST(COUNT (CASE 
                WHEN (CAST(order_timestamp AS TIME) BETWEEN '11:00:00' AND '14:00:00') 
                  OR (CAST(order_timestamp AS TIME) BETWEEN '18:00:00' AND '21:00:00') 
                THEN order_id
                END) 
    AS FLOAT) AS peak_hour_orders,
    CAST(COUNT( CASE 
                WHEN order_rating IS NOT NULL 
                THEN order_id 
                END) 
    AS FLOAT) AS rated_orders,
    ROUND(AVG(  CASE 
                WHEN order_rating IS NOT NULL 
                THEN CAST(order_rating AS FLOAT) 
                END)
    ,2) AS average_rating
    FROM restaurant_orders
    GROUP BY customer_id
)
SELECT  customer_id, 
        total_orders,
        ROUND(100 * peak_hour_orders / total_orders, 0) AS peak_hour_percentage, 
        average_rating
FROM customer_behavior
WHERE   total_orders >= 3 
    AND peak_hour_orders / total_orders >= 0.60
    AND average_rating >= 4.0
    AND rated_orders / total_orders >= 0.50
ORDER BY average_rating DESC, customer_id​​​​​​​ DESC;
