WITH co_product AS (
    SELECT  u1.product_id AS product1_id, 
            u2.product_id AS product2_id,
            COUNT(*) AS customer_count
    FROM ProductPurchases u1 INNER JOIN ProductPurchases u2 
        ON u1.user_id=u2.user_id AND u1.product_id < u2.product_id
    GROUP BY u1.product_id, u2.product_id
    HAVING COUNT(u1.user_id) >=3
)
SELECT  product1_id, 
        product2_id,
        i1.category AS product1_category, 
        i2.category AS product2_category, 
        customer_count
FROM co_product
INNER JOIN ProductInfo i1 ON i1.product_id = product1_id
INNER JOIN ProductInfo i2 ON i2.product_id = product2_id
ORDER BY customer_count DESC, product1_id, product2_id;
