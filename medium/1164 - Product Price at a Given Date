WITH table_A AS (
    SELECT product_id, new_price,
    ROW_NUMBER() OVER(PARTITION BY product_id ORDER BY change_date DESC) AS rn
    FROM Products
    WHERE change_date <= '2019-08-16'
),
all_products AS (
    SELECT DISTINCT product_id FROM Products
)
SELECT p.product_id, COALESCE(a.new_price,10) AS price
FROM all_products p LEFT JOIN table_A a ON p.product_id=a.product_id AND a.rn=1
