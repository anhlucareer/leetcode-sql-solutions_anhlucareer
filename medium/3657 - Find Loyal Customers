WITH transaction_behavior AS (
    SELECT customer_id,
    COUNT(  CASE WHEN transaction_type = 'purchase' 
            THEN transaction_id 
    END) AS purchase_transactions,
    DATEDIFF(day, MIN(transaction_date), MAX(transaction_date)) AS active_days,
    CAST(COUNT( CASE 
                WHEN transaction_type = 'refund' THEN transaction_id 
                END) 
    AS FLOAT) AS refund_transactions,
    CAST(COUNT(transaction_id) AS FLOAT) AS all_transactions
    FROM customer_transactions
    GROUP BY customer_id
)
SELECT customer_id
FROM transaction_behavior
WHERE   purchase_transactions >= 3 
    AND active_days >= 30
    AND ROUND(refund_transactions / all_transactions,2) < 0.20
ORDER BY customer_id ASC;
